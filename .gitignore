# Sensitive environment variables & secrets (NEVER COMMIT)
.env
**/.env
.env.local
.env.*.local
*.env
!*.env.example
secrets/*
**/secrets/*
!**/secrets/.gitkeep
credentials.json
service-account*.json
*.pem
*.key

# Runtime uploaded / processed imagery (keep dir with .gitkeep)
**/input_images/*
!**/input_images/.gitkeep

# System / IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Log files
*.log
logs/

# Local developer logs & commit histories (NEVER COMMIT TO GITHUB)
GIT_COMMIT_LOG.md
git_commit_log.md
Git_Commit_Log.md
*commit_log*.md

