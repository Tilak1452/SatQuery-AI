# Google Earth Engine Configuration
# For local dev: GEE_PROJECT with earthengine authenticate
GEE_PROJECT=krishi-dhristi

# For Cloud Deployment (Render/Railway/Docker):
# Option A: Paste full JSON string of Service Account into GEE_SERVICE_ACCOUNT_JSON
# GEE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# Option B: Path to downloaded JSON key file
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-service-account.json
GEE_SERVICE_ACCOUNT_EMAIL=

# CORS & Constraints
FRONTEND_ORIGIN=http://localhost:5173
MAX_AOI_AREA_KM2=250
MIN_AOI_AREA_KM2=1.0

